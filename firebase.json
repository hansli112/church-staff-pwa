{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        "test/**"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "app/build/web",
    "ignore": [
      "firebase.json",
      "**/.!(well-known)",
      "**/.!(well-known)/**"
    ],
    "redirects": [
      {
        "source": "/support/",
        "destination": "/support",
        "type": 301
      },
      {
        "source": "/about",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/about.html",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/support",
        "destination": "/support.html"
      },
      {
        "source": "/support/pay",
        "function": {
          "functionId": "newebpayStart",
          "region": "asia-east1"
        }
      },
      {
        "source": "/c/**",
        "function": {
          "functionId": "churchPage",
          "region": "asia-east1"
        }
      },
      {
        "source": "**",
        "destination": "/app.html"
      }
    ],
    "headers": [
      {
        "regex": "^/(?:[^c].*|c[^/].*|c)?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.png",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "regex": "^/assets/.+\\.[0-9a-f]{10}\\.(otf|ttf)$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "regex": "^/main\\.dart(?:\\.js_[0-9]+\\.part)?\\.[0-9a-f]{10}\\.js$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "regex": "^/asset-bundles/[0-9a-f]{10}/assets/.+$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "predeploy": [
      "\"$PROJECT_DIR\"/scripts/hosting-predeploy.sh"
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8181
    },
    "auth": {
      "port": 9199
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9399
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
