rules_version = '2';

// Firestore security rules for 馬大別忙 (hosted, multi-church).
//
// Data model (docs/data-model.md has the full field list):
//   users/{uid}                              - global profile: name, locale, appLocale, fcm
//   churches/{cid}                           - name, nameKey, status
//   churches/{cid}/members/{uid}             - role, groups, zones in that church
//   churches/{cid}/rosters/{rosterId}        - service rosters
//   churches/{cid}/staff_orders/{type}       - per-service staff ranking
//   churches/{cid}/settings/{doc}            - admin-managed church settings
//
// Threat model:
//   - Every church shares one project, so the church in the path is the
//     tenant boundary. Every rule under churches/{cid} checks membership of
//     *that* cid; being admin of one church grants nothing in another.
//   - Client-side checks can be bypassed with the public web SDK. These rules
//     are the real enforcement boundary.
//   - Creating a church, joining one, renaming one and changing its status all
//     go through Cloud Functions (Admin SDK, bypasses these rules), because
//     each needs a check the rules cannot do: the duplicate-name lookup, an
//     invite or an admin letting in a request to join, or being the platform
//     operator. No client may write those docs.
//   - Removing a member deletes churches/{cid}/members/{uid}; the Auth account
//     survives and keeps a valid ID token. Every church rule therefore needs
//     an existing member doc, not just a signed-in user.
//   - Text lengths are the exception: their limits count characters as a
//     person does, which size() cannot (it counts UTF-16 code units). The app
//     holds the limit; a size() here is the limit × 4, an abuse guard only.
//     The limits are TextLimits in app/lib/domain/limits.dart, and
//     functions/test/limits.test.ts fails when a number here disagrees.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function churchPath(cid) {
      return /databases/$(database)/documents/churches/$(cid);
    }

    function memberPath(cid) {
      return /databases/$(database)/documents/churches/$(cid)/members/$(request.auth.uid);
    }

    // Holds a membership, whatever the church's status. Only used where a
    // member of a suspended church still needs to see why it is closed.
    function hasMembership(cid) {
      return isSignedIn() && exists(memberPath(cid));
    }

    // A member of an active church. The baseline for every church rule: a
    // removed member, or any member of a suspended or deleted church, gets
    // nothing. exists() before get() so a missing doc denies instead of
    // erroring.
    function isMember(cid) {
      return hasMembership(cid)
        && exists(churchPath(cid))
        && get(churchPath(cid)).data.get('status', '') == 'active';
    }

    function member(cid) {
      return get(memberPath(cid)).data;
    }

    function isAdmin(cid) {
      return isMember(cid) && member(cid).get('role', '') == 'admin';
    }

    // Permission groups, in the Linux sense: a member may hold several, they
    // are orthogonal, and admin is root — it holds every group without being
    // listed in any. A group never grants identity power: adding members,
    // changing roles, granting groups and writing settings stay isAdmin(), so
    // a grant cannot spread without an admin.
    function inGroup(cid, name) {
      return isAdmin(cid)
        || (isMember(cid) && name in member(cid).get('groups', []));
    }

    // Leads something (#82): a service, as its 負責人 or 牧者, or a 事工.
    // Leads pick people for rosters and add 同工 to their group, so they
    // read the member list as 行政 and admins do.
    function isLead(cid) {
      return isMember(cid)
        && (member(cid).get('leadTypes', []).size() > 0 || member(cid).get('leadMinistries', []).size() > 0
            || member(cid).get('leadSmallGroups', []).size() > 0);
    }

    // Reads the member list: admins, 行政 (roster-editors) and leads.
    function readsMembers(cid) {
      return inGroup(cid, 'roster-editors') || isLead(cid);
    }

    function hasValidGroups() {
      return !('groups' in request.resource.data)
        || request.resource.data.groups.hasOnly(['roster-editors', 'calendar-editors']);
    }

    function hasValidRole() {
      return request.resource.data.role in ['admin', 'leader', 'staff', 'member'];
    }

    // Every service ID this church has ever configured. The church's
    // settings/services is seeded when the church is created; its ids list
    // only ever grows (validServiceSettings), so a roster or zone that once
    // named an ID keeps a valid type.
    function serviceTypes(cid) {
      let path = /databases/$(database)/documents/churches/$(cid)/settings/services;
      return exists(path) ? get(path).data.get('ids', []) : [];
    }

    function validServiceSettings() {
      let data = request.resource.data;
      let before = resource == null ? [] : resource.data.get('ids', []);
      return data.keys().hasOnly(['services', 'ids', 'updatedAt'])
        && data.services is list && data.services.size() >= 1 && data.services.size() <= 20
        && data.ids is list && data.ids.size() <= 100
        && data.ids.hasAll(before);
    }

    // Every 事工 ID this church has ever had: like serviceTypes, ids only
    // grows (validMinistrySettings).
    function ministryIds(cid) {
      let path = /databases/$(database)/documents/churches/$(cid)/settings/ministries;
      return exists(path) ? get(path).data.get('ids', []) : [];
    }

    // Every 小組 ID this church has ever had (#85), kept by the backend
    // (functions/src/smallGroups.ts): like ministryIds, it only grows.
    function smallGroupIds(cid) {
      let path = /databases/$(database)/documents/churches/$(cid)/settings/smallGroups;
      return exists(path) ? get(path).data.get('ids', []) : [];
    }

    function validMinistrySettings() {
      let data = request.resource.data;
      let before = resource == null ? [] : resource.data.get('ids', []);
      return data.keys().hasOnly(['ministries', 'ids', 'updatedAt'])
        && data.ministries is list && data.ministries.size() <= 50
        && data.ids is list && data.ids.size() <= 100
        && data.ids.hasAll(before);
    }

    // 身分 (#82): `identities` is what the 同工 page shows and edits; the
    // rules read its flattened projections, written alongside it like
    // zoneTypes: the services led (leadTypes, by a 負責人 or 牧者), the 事工
    // led (leadMinistries), and the 事工 they are a 同工 of (ministries); the
    // 小組 led (leadSmallGroups, by a 小組長) and those they are in
    // (smallGroups, #85).
    // 管理員 is still role 'admin' and 行政 the roster-editors and
    // calendar-editors groups, which older apps read.
    function hasValidIdentities(cid) {
      let data = request.resource.data;
      return (!('identities' in data) || (data.identities is list && data.identities.size() <= 20))
        && (!('leadTypes' in data) || (data.leadTypes is list && data.leadTypes.hasOnly(serviceTypes(cid))))
        && (!('leadMinistries' in data)
            || (data.leadMinistries is list && data.leadMinistries.hasOnly(ministryIds(cid))))
        && (!('ministries' in data) || (data.ministries is list && data.ministries.hasOnly(ministryIds(cid))))
        && (!('leadSmallGroups' in data)
            || (data.leadSmallGroups is list && data.leadSmallGroups.hasOnly(smallGroupIds(cid))))
        && (!('smallGroups' in data) || (data.smallGroups is list && data.smallGroups.hasOnly(smallGroupIds(cid))));
    }

    // zones on a member doc is a list of maps, and the rules language has no
    // loops — there is no way to read serviceType out of it. So the app writes
    // a flattened projection alongside it, `zoneTypes`, and the rules read that.
    function hasValidZoneTypes(cid) {
      return !('zoneTypes' in request.resource.data)
        || request.resource.data.zoneTypes.hasOnly(serviceTypes(cid));
    }

    // 行政 (roster-editors) and admins edit every service's rosters; a
    // service's 負責人 or 牧者 its own (leadTypes, #82). A 牧區 alone grants
    // nothing. A 事工's 負責人 edits only their duties, which the rules
    // cannot tell apart in a roster's duties list: that goes through the
    // backend (editLedDuties).
    function canEditRosterType(cid, type) {
      return type in serviceTypes(cid) && (inGroup(cid, 'roster-editors')
        || type in member(cid).get('leadTypes', []));
    }

    // Arranges all of an event's roster: admins and 行政 any; a group's 負責人
    // its group's events (#84), whose roster says the group (`group`, set
    // by the backend from the event; the church's events have none).
    function arrangesEvent(cid, data) {
      let g = data.get('group', '');
      return inGroup(cid, 'roster-editors')
        || (g.matches('service:.+') && g.split(':')[1] in member(cid).get('leadTypes', []))
        || (g.matches('ministry:.+') && g.split(':')[1] in member(cid).get('leadMinistries', []))
        || (g.matches('small:.+') && g.split(':')[1] in member(cid).get('leadSmallGroups', []));
    }

    // 回報人數 (#85) of group [key], `service:<id>` or `small:<id>`
    // (testdata/church_rules.json, attendanceAccess, as
    // functions/src/attendance.ts): admins any; a service's 負責人 and 牧者
    // its own and its 小組'; a 小組長 their 小組's. 行政 also sees a
    // service's.
    function writesAttendance(cid, key) {
      let kind = key.split(':')[0];
      let id = key.split(':')[1];
      let leads = member(cid).get('leadTypes', []);
      let small = /databases/$(database)/documents/churches/$(cid)/smallGroups/$(id);
      return isMember(cid) && key.matches('(service|small):[A-Za-z0-9_-]{1,64}')
        && (isAdmin(cid)
          || (kind == 'service' && id in leads)
          || (kind == 'small' && (id in member(cid).get('leadSmallGroups', [])
              || (exists(small) && get(small).data.get('service', '') in leads))));
    }

    function readsAttendance(cid, key) {
      return writesAttendance(cid, key)
        || (isMember(cid) && key.matches('service:[A-Za-z0-9_-]{1,64}') && inGroup(cid, 'roster-editors'));
    }

    function isEventRoster(data) {
      return data.get('kind', '') == 'event';
    }

    // The event's title and days are copied from the calendar, the days in
    // the church's time zone like every dateKey, with where the event is (calendarId, and a
    // recurring event's series and original start) for eventSync. Only the
    // backend cancels one (cancelledAt), when its event is deleted.
    function validEventRoster(rosterId) {
      let roster = request.resource.data;
      let day = '^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$';
      return isEventRoster(roster)
        && roster.keys().hasOnly(['kind', 'eventId', 'title', 'dateKey', 'endDateKey', 'duties', 'events', 'via', 'updatedAt',
             'calendarId', 'recurringEventId', 'originalStart', 'group'])
        && (!('group' in roster) || (roster.group is string && roster.group.matches('(service|ministry|small):[A-Za-z0-9_-]{1,64}')))
        && roster.eventId is string && rosterId == 'ev_' + roster.eventId
        && roster.title is string && roster.title.size() <= 800
        && roster.dateKey is string && roster.dateKey.matches(day)
        && roster.endDateKey is string && roster.endDateKey.matches(day)
        && roster.endDateKey >= roster.dateKey
        && roster.duties is list
        && roster.get('calendarId', '') is string && roster.get('calendarId', '').size() <= 1024
        && roster.get('recurringEventId', '') is string && roster.get('recurringEventId', '').size() <= 1024
        && roster.get('originalStart', '') is string && roster.get('originalStart', '').size() <= 64;
    }

    function onlyTouches(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // A person's name, on users/{uid} and on member docs: an abuse guard,
    // 4 UTF-16 units for each of the 40 characters the app allows.
    function hasValidName() {
      return !('name' in request.resource.data)
        || (request.resource.data.name is string
            && request.resource.data.name.size() <= 160);
    }

    function hasValidDateKey() {
      return !('dateKey' in request.resource.data)
        || (request.resource.data.dateKey is string
            && request.resource.data.dateKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'));
    }

    // Global profile. Only its owner ever reads it: names shown inside a
    // church come from the member doc, and push tokens are read by Cloud
    // Functions. Deleting it is part of account deletion, done server-side.
    match /users/{uid} {
      function validProfile() {
        return request.resource.data.keys().hasOnly(
            ['name', 'email', 'locale', 'appLocale', 'fcm', 'photoAiConsentAt', 'createdAt', 'updatedAt'])
          && hasValidName()
          // Push tokens, {deviceId: token}: one per install, dropped by the
          // backend once FCM says they are dead.
          && (!('fcm' in request.resource.data)
              || (request.resource.data.fcm is map && request.resource.data.fcm.size() <= 50))
          // The language the app shows, for the server's pushes.
          && (!('appLocale' in request.resource.data)
              || (request.resource.data.appLocale is string
                  && request.resource.data.appLocale.size() <= 16))
          // When they agreed to photo recognition sending to Gemini.
          && (!('photoAiConsentAt' in request.resource.data)
              || request.resource.data.photoAiConsentAt is timestamp);
      }

      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid) && validProfile();
    }

    // The church switcher lists the caller's own memberships with a
    // collection-group query on members where uid == me. Rules must be
    // provable from the query, so this checks the uid field, not the path.
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /churches/{cid} {
      // A member of a suspended church can still read its status, so the app
      // can say the church is closed instead of failing everywhere.
      allow read: if hasMembership(cid);

      // An admin sets the home-screen name (removing the field falls back to
      // the church name) and turns 回報人數 on (attendanceSince, the day it
      // was; #85) or off (removed), and stops or again takes requests to
      // join (joinRequestsClosed, #88). Everything else on the church doc is
      // the backend's, the time zone too (setChurchTimeZone: it also clears
      // the calendar's cached months and moves the church link's next fetch).
      allow update: if isAdmin(cid)
        && onlyTouches(['homeName', 'attendanceSince', 'joinRequestsClosed'])
        && (!('joinRequestsClosed' in request.resource.data) || request.resource.data.joinRequestsClosed == true)
        && (!('homeName' in request.resource.data)
            || (request.resource.data.homeName is string
                && request.resource.data.homeName.size() >= 1
                && request.resource.data.homeName.size() <= 32))
        && (!('attendanceSince' in request.resource.data)
            || (request.resource.data.attendanceSince is string
                && request.resource.data.attendanceSince.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));

      match /members/{uid} {
        // Own membership, or readsMembers: the roster people picker lists
        // this collection. Firestore has no field-level read restriction, so
        // whoever arranges rosters sees every member's email.
        allow read: if isSelf(uid) || readsMembers(cid);

        // Joining is an invite redemption, done by a Cloud Function.
        allow create: if false;

        //   - admin: anything, except changing who the doc belongs to or
        //            taking away their own admin role
        //   - self : only notificationPrefs. Not role, not groups.
        //
        // An admin can neither demote nor remove themself, so a church always
        // keeps someone who can manage it. Another admin can do both.
        allow update: if hasValidPrefs() && ((isAdmin(cid) && hasValidRole() && hasValidGroups()
              && hasValidZoneTypes(cid) && hasValidIdentities(cid) && hasValidName()
              && request.resource.data.uid == uid
              && (!isSelf(uid) || request.resource.data.role == 'admin'))
          || (isSelf(uid) && isMember(cid) && onlyTouches(['notificationPrefs'])));

        // Which pushes the member turned off here, and when reminders come
        // (functions/src/push.ts, notifications.ts). Only what a write
        // changes is checked: prefs moved from self-host may carry older
        // kinds, and the app writes one field at a time.
        function hasValidPrefs() {
          let p = request.resource.data.get('notificationPrefs', {});
          let changed = p is map ? p.diff(resource.data.get('notificationPrefs', {})).affectedKeys() : null;
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['notificationPrefs'])
            || (p is map
              && changed.hasOnly(['muted', 'reminderTiming'])
              && (!changed.hasAny(['muted']) || !('muted' in p)
                  || (p.muted is list && p.muted.hasOnly(['reminder', 'rosterChange', 'memberLeft', 'attendance', 'joinRequest'])))
              && (!changed.hasAny(['reminderTiming']) || !('reminderTiming' in p)
                  || p.reminderTiming in ['weekly', 'dayBefore', 'both']));
        }

        // A non-admin may leave on their own. An admin must be demoted by
        // another admin first, which is how the last admin is kept in place.
        allow delete: if (isAdmin(cid) && !isSelf(uid))
          || (isSelf(uid) && resource.data.get('role', '') != 'admin');
      }

      // Members moved from self-host who have not signed in yet. Listed
      // with the members; only an admin may drop one. The backend creates
      // them (a move) and turns them into members (a claim or a merge).
      match /pendingMembers/{id} {
        allow read: if readsMembers(cid);
        allow delete: if isAdmin(cid);
      }

      // 申請加入 (#88): someone without an invite asking to join, by uid.
      // Admins read them to let them in or not. Asking, taking it back and
      // answering all go through the backend (functions/src/joinRequests.ts):
      // the person asking is no member and reads nothing here.
      match /joinRequests/{uid} {
        allow read: if isAdmin(cid);
      }

      match /rosters/{rosterId} {
        allow read: if isMember(cid);

        // A service's day. Editors must hold both the old and new service's
        // zone. An admin may repair an unknown type to a configured one;
        // nobody can write a new unknown type. Never an event's roster.
        allow create: if !isEventRoster(request.resource.data) && !rosterId.matches('ev_.*')
          && hasValidDateKey()
          && canEditRosterType(cid, request.resource.data.get('type', ''));
        allow update: if !isEventRoster(request.resource.data) && !isEventRoster(resource.data)
          && hasValidDateKey()
          && canEditRosterType(cid, request.resource.data.get('type', ''))
          && (isAdmin(cid) || canEditRosterType(cid, resource.data.get('type', '')));
        allow delete: if !isEventRoster(resource.data)
          && canEditRosterType(cid, resource.data.get('type', ''));

        // 活動的服事表: one per calendar event, at ev_<eventId>, in no
        // service, so no zone: admins and 行政, and a group's 負責人 for the
        // group's events (arrangesEvent; the group the app gives a new one
        // is set again from the event by calendarWrite and the sync, and the
        // app never changes it). It never turns
        // into a service's day or back, which would get round the zones, and
        // a service's day never takes an ev_ ID. Its title and days are the
        // calendar's: the app sets them when making it, then only
        // calendarWrite changes them.
        allow create: if validEventRoster(rosterId) && arrangesEvent(cid, request.resource.data);
        allow update: if validEventRoster(rosterId) && isEventRoster(resource.data)
          && !('cancelledAt' in resource.data)
          // movedBy: who moved it, which calendarWrite records for the
          // trigger; an app write drops it.
          && onlyTouches(['duties', 'events', 'via', 'updatedAt', 'movedBy'])
          && arrangesEvent(cid, resource.data);
        allow delete: if isEventRoster(resource.data) && arrangesEvent(cid, resource.data);
      }

      // 小組 (#85): everyone in the church sees them; opening, changing and
      // closing one, and naming its 小組長, is editSmallGroup's.
      match /smallGroups/{id} {
        allow read: if isMember(cid);
      }

      // 回報人數 (#85) of group {key}: its pauses on the group's doc
      // (`pauses`, each {from, until}, kept once over), and each meeting's
      // 人數 under days/{dateKey}: a count (0–100000) with an optional note,
      // or none (這次沒聚會). A lead may fill one in later (補填) or change it.
      match /attendance/{key} {
        allow read: if readsAttendance(cid, key);
        allow create, update: if writesAttendance(cid, key)
          && request.resource.data.keys().hasOnly(['pauses', 'updatedAt'])
          && request.resource.data.get('pauses', []) is list
          && request.resource.data.get('pauses', []).size() <= 50;

        match /days/{day} {
          allow read: if readsAttendance(cid, key);
          allow create, update: if writesAttendance(cid, key) && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && request.resource.data.keys().hasOnly(['count', 'note', 'none', 'by', 'updatedAt'])
            && request.resource.data.get('by', '') == request.auth.uid
            && (request.resource.data.get('none', false) == true
                ? !('count' in request.resource.data) && !('note' in request.resource.data)
                : (request.resource.data.count is int
                    && request.resource.data.count >= 0 && request.resource.data.count <= 100000
                    && request.resource.data.get('note', '') is string
                    && request.resource.data.get('note', '').size() <= 800));
          allow delete: if writesAttendance(cid, key);
        }
      }

      match /staff_orders/{type} {
        allow read: if isMember(cid);
        allow write: if canEditRosterType(cid, type);
      }

      match /settings/{doc} {
        // Written only by the backend: the calendar connection, the church
        // link's fetched content, the webhook settings.
        function serverOnly() {
          return doc in ['calendar', 'linkContent', 'webhook', 'smallGroups'];
        }

        // 教會連結: a title, a body and an https link. Its content source and
        // fetch time are set through a Cloud Function, which fetches the
        // source at once; the app leaves them as they are.
        function validChurchLink() {
          let data = request.resource.data;
          let before = resource == null ? {} : resource.data;
          return data.keys().hasOnly(['title', 'body', 'url', 'source', 'fetchMinute', 'updatedAt'])
            && !data.diff(before).affectedKeys().hasAny(['source', 'fetchMinute'])
            && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
            && data.get('body', '') is string && data.get('body', '').size() <= 480
            && data.url is string && data.url.size() <= 500 && data.url.matches('https://[^ ]+');
        }

        // The webhook URL may carry a token of the receiver: admins only.
        allow read: if isMember(cid) && (doc != 'webhook' || isAdmin(cid));
        allow create, update: if isAdmin(cid) && !serverOnly()
          && (doc != 'services' || validServiceSettings())
          && (doc != 'ministries' || validMinistrySettings())
          && (doc != 'link' || validChurchLink());
        // settings/services and settings/ministries are never deleted: their
        // ids only grow.
        allow delete: if isAdmin(cid) && !(doc in ['services', 'ministries']) && !serverOnly();
      }
    }

    // Invites: a church's admins create, list and revoke them. Redeeming one
    // is a Cloud Function (only the backend creates member docs), so nobody
    // else reads them; the code itself is the secret.
    match /invites/{code} {
      allow read: if isAdmin(resource.data.cid);
      allow create: if isAdmin(request.resource.data.cid)
        && code.matches('^[A-Z0-9]{8,16}$')
        && request.resource.data.keys().hasOnly(
             ['cid', 'churchName', 'expiresAt', 'revoked', 'createdBy', 'createdAt', 'zoneTypes'])
        // The 牧區 its members join; redeemInvite keeps only real services.
        && request.resource.data.get('zoneTypes', []) is list
        && request.resource.data.get('zoneTypes', []).size() <= 20
        && request.resource.data.revoked == false
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(31, 'd');
      // Revoking is the only change, and it is final.
      allow update: if isAdmin(resource.data.cid)
        && onlyTouches(['revoked'])
        && request.resource.data.revoked == true;
    }

    // Daily platform snapshots, written by a scheduled function. Only the
    // platform operator (custom claim) reads them.
    match /stats/{date} {
      allow read: if isSignedIn() && request.auth.token.operator == true;
    }

    // 雲端費用進度: the summary on the support pages, the app's and the
    // website's (read without signing in). Functions write it; the cost list
    // (platform/fundingCosts), months (fundingMonths), payments
    // (fundingPayments), the website's ECPay orders (ecpayOrders) and
    // their hourly count (platform/ecpayRate) stay backend-only.
    match /platform/funding {
      allow read: if true;
    }

    // The oldest store builds still allowed to run (minBuild.android,
    // minBuild.ios): read before signing in, so an old app asks for the
    // update first. Set by the operator in the console, never by the app.
    match /platform/app {
      allow read: if true;
    }

    // churchNames/{nameKey} (name reservations), linkSources/{cid} (the
    // church link fetch schedule), webhookSecrets/{cid}, webhookOutbox/{cid}
    // (roster changes waiting to go out), heldPushes (roster pushes held over
    // quiet hours), pendingIndex/{email hash} (who has
    // a pending member where) and everything else: no client access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
