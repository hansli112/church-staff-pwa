rules_version = '2';

// Firestore security rules for church_staff_pwa.
//
// Data model (see lib/features/**/data/repositories/*.dart):
//   users/{uid}                              - user profile, includes role/fcm/notificationPrefs
//   rosters/{rosterId}                       - service rosters
//   settings/roster_templates                - admin-managed templates
//   settings/event_options                   - admin-managed event options
//   settings/small_group_templates           - admin-managed small group templates
//   staff_orders/{serviceType}               - per-service staff ranking, zone editors
//
// Threat model:
//   - Auth-only client-side checks can be bypassed by calling Firestore directly
//     with the public web SDK. These rules are the real enforcement boundary.
//   - The most dangerous path is self privilege-escalation by writing role=admin
//     to users/{uid}. This is blocked by selfUpdateOnlyTouches().
//   - Deleting a user from the admin UI only removes users/{uid}; the Firebase
//     Auth account survives (client SDKs cannot delete other accounts), so a
//     removed member keeps a valid ID token. Every rule therefore requires
//     isActiveUser() — an existing users/{uid} doc — not just isSignedIn().
//     Deleting the doc revokes all access immediately.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Signed in AND still a member (users/{uid} exists). This is the baseline
    // for every collection: a deleted member holding an old token gets nothing.
    function isActiveUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Permission groups, in the Linux sense: a user may hold several, they are
    // orthogonal (calendar without roster is a valid grant), and admin is root
    // — it holds every group without being listed in any.
    //
    // `data.get('groups', [])` is what makes this need no migration: every
    // existing user document predates the field and reads as "no groups".
    //
    // A group never grants identity power. Creating accounts, changing anyone's
    // role, granting groups, deleting users and writing settings/ templates all
    // stay isAdmin(). That is the point of the split: a member of a group
    // cannot add anyone to one, so the grant cannot spread without an admin.
    function inGroup(name) {
      return isAdmin()
        || (isActiveUser()
            && name in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('groups', []));
    }

    // Group names must be ones the app knows. A typo would otherwise sit in the
    // document looking like a grant while matching nothing.
    function hasValidGroups() {
      return !('groups' in request.resource.data)
        || request.resource.data.groups.hasOnly(['roster-editors', 'calendar-editors']);
    }

    // Which configured service IDs this user may touch a roster for.
    //
    // zones on users/{uid} is a list of maps, and the rules language has no
    // loops and no map/filter — there is no way to read serviceType out of it.
    // So the app writes a flattened projection alongside it, `zoneTypes` (see
    // User.zoneTypes). This reads that projection.
    //
    // The two can only drift if someone writes users/{uid} outside the app
    // (console, Admin SDK), and only admin can write user docs at all. Drift is
    // invisible in the UI, which reads zones — it shows up as a roster write
    // that fails. `node scripts/backfill-user-zone-types.mjs --check` audits it.
    //
    // Being in roster-editors is not enough: the group says "may edit rosters",
    // the zone says "which one". admin keeps every type without holding a zone.
    function canEditRosterType(type) {
      return type in serviceTypes() && (isAdmin()
        || (inGroup('roster-editors')
            && type in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('zoneTypes', [])));
    }

    // Generated from church.json, including disabled IDs for existing records.
    // Do not edit this list: run scripts/prepare-deployment.mjs instead.
    function serviceTypes() {
      // BEGIN GENERATED SERVICE IDS
      return ['sundayService', 'youth', 'children'];
      // END GENERATED SERVICE IDS
    }

    // Same idea as hasValidGroups(): a typo'd service type would sit in the
    // document looking like a grant while matching no roster.
    function hasValidZoneTypes() {
      return !('zoneTypes' in request.resource.data)
        || request.resource.data.zoneTypes.hasOnly(serviceTypes());
    }

    // Role must be one of the values UserRole knows how to parse. Blocks an
    // admin (or a compromised admin session) from writing junk that
    // User.fromJson would silently coerce to 'member'.
    function hasValidRole() {
      return request.resource.data.role in ['admin', 'leader', 'staff', 'member'];
    }

    // True iff the update only changes fields in `allowed`.
    // Used to block self-promotion to admin.
    function selfUpdateOnlyTouches(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    match /users/{uid} {
      // Own profile (needed on every login), or roster-editors. The roster
      // people picker calls getUsers(), so anyone who can edit a roster must be
      // able to list this collection.
      //
      // Deliberately roster-editors and not "any group": someone who only
      // manages calendar events has no reason to read the directory. Note the
      // cost of the grant that remains — Firestore has no field-level read
      // restriction, so a roster editor can see every member's email and FCM
      // token. Everyone else still cannot list the collection at all.
      allow read: if isSelf(uid) || inGroup('roster-editors');

      // Only admin creates new user docs (via SecondaryApp flow in user_editor_screen).
      allow create: if isAdmin() && hasValidRole() && hasValidGroups()
        && hasValidZoneTypes();

      // Updates:
      //   - admin: full control over any user doc
      //   - self : only fcm and notificationPrefs. Note what this excludes:
      //             role AND groups, so nobody can grant themselves a group.
      allow update: if (isAdmin() && hasValidRole() && hasValidGroups()
            && hasValidZoneTypes())
        || (isSelf(uid)
            && isActiveUser()
            && selfUpdateOnlyTouches(['fcm', 'notificationPrefs']));

      allow delete: if isAdmin();
    }

    // Legacy records without dateKey remain readable and editable.
    function hasValidDateKey() {
      return !('dateKey' in request.resource.data)
        || (request.resource.data.dateKey is string
            && request.resource.data.dateKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'));
    }

    match /rosters/{rosterId} {
      allow read: if isActiveUser();

      // Editors must hold both the old and new service's zone. An admin may
      // explicitly repair a missing/unknown legacy type to a configured ID;
      // nobody can write a new unknown type or silently fall back to another.
      allow create: if hasValidDateKey()
        && canEditRosterType(request.resource.data.get('type', ''));
      allow update: if hasValidDateKey()
        && canEditRosterType(request.resource.data.get('type', ''))
        && (isAdmin() || canEditRosterType(resource.data.get('type', '')));
      allow delete: if canEditRosterType(resource.data.get('type', ''));
    }

    // Staff ordering carries the same service-specific permission as a roster.
    match /staff_orders/{type} {
      allow read: if isActiveUser();
      allow write: if type in serviceTypes() && canEditRosterType(type);
    }

    // The shape of rosters affects everyone and remains admin-only.
    match /settings/{doc} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
