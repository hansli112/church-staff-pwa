# ── GitHub Actions Variables (Settings → Variables) ──────────────────────────
# Firebase Web Config (non-sensitive, designed to be public)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Google Calendar
GOOGLE_CALENDAR_ID=

# ── GitHub Actions Secrets (Settings → Secrets) ───────────────────────────────
# Google Calendar API key (protect to avoid quota abuse)
GOOGLE_CALENDAR_API_KEY=

# Firebase Cloud Messaging VAPID key (push notifications auth)
FCM_WEB_VAPID_KEY=

# ── Cloudflare Pages 環境變數（執行期，不是 build 期）────────────────────────
# 給 functions/api/calendar/ 寫入 Google Calendar 用。在 Cloudflare Pages 專案
# 的 Settings → Environment variables 設定，Production 與 Preview 各設一次。
# 這些不會進 build，也不會出現在前端 bundle 裡。
#
# service account 的 JSON 金鑰全文（設成 Secret）。
# 該 service account 的 email 必須被加進日曆的共用清單，權限為「變更活動」。
GOOGLE_SERVICE_ACCOUNT_JSON=
# 下面兩個與上面 build 用的值相同，但要在 Cloudflare 那邊再設一次。
# GOOGLE_CALENDAR_ID=
# FIREBASE_PROJECT_ID=

# 新增事件後通知 n8n，由 n8n 發 LINE 群組訊息（見 worker/line_notify.js）。
# 兩個任一沒設就整個關掉，所以 Preview 環境刻意留空 —— 否則預覽站點上的測試
# 資料會被推進真的 LINE 群組。
# NOTIFY_WEBHOOK_SECRET 要和 n8n Webhook node 的 Header Auth 憑證一致，
# header 名稱是 x-notify-secret。
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
