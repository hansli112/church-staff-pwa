# ── GitHub Actions Variables (Settings → Variables) ──────────────────────────
# Firebase Web Config (non-sensitive, designed to be public)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Google Calendar
GOOGLE_CALENDAR_ID=

# ── GitHub Actions Secrets (Settings → Secrets) ───────────────────────────────
# Google Calendar API key (protect to avoid quota abuse)
GOOGLE_CALENDAR_API_KEY=

# Firebase Cloud Messaging VAPID key (push notifications auth)
FCM_WEB_VAPID_KEY=

# ── Cloudflare Pages 環境變數（執行期，不是 build 期）────────────────────────
# 給 functions/api/calendar/ 寫入 Google Calendar 用。在 Cloudflare Pages 專案
# 的 Settings → Environment variables 設定，Production 與 Preview 各設一次。
# 這些不會進 build，也不會出現在前端 bundle 裡。
#
# service account 的 JSON 金鑰全文（設成 Secret）。
# 該 service account 的 email 必須被加進日曆的共用清單，權限為「變更活動」。
GOOGLE_SERVICE_ACCOUNT_JSON=
# 下面兩個與上面 build 用的值相同，但要在 Cloudflare 那邊再設一次。
# GOOGLE_CALENDAR_ID=
# FIREBASE_PROJECT_ID=

# 新增事件後通知 n8n，由 n8n 發 LINE 群組訊息（見 worker/line_notify.js）。
# 兩個任一沒設就整個關掉。Production 與 Preview 都要設 —— 日常操作在 dev 的
# 預覽站上，只設 production 的話平常用的站台就收不到通知。
#
# 注意兩個環境會發到同一個 LINE 群組：n8n 那條 workflow 的群組 ID 是寫死的。
# 想讓預覽站發到別的地方，要在 n8n 依 query string 分流，不是把這裡留空。
# NOTIFY_WEBHOOK_SECRET 要和 n8n Webhook node 的 Header Auth 憑證一致，
# header 名稱是 x-notify-secret。
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# 服事表照片轉 JSON（見 functions/api/roster/import-image.js）。
# 已經設好了，這裡留著是給下一個接手的人看的。
# AI Studio 的 key：https://aistudio.google.com/apikey
# 建 key 時專案選 church-staff-pwa（沒開帳單 = 免費層）。
# 設成 Secret，Production 與 Preview 各設一次。
#
# ⚠ 這把 key 只能放在這一區（Cloudflare 執行期）。放到上面那區會被編進
#   前端 bundle，等於公開。也不要用 --dart-define 傳進 Flutter，那會明文
#   出現在 main.dart.js 裡。
GEMINI_API_KEY=
# 選填。不設就用 worker/gemini.js 裡釘住的那個型號。
# 只有在 Google 把那個型號下架時才需要動它。
# GEMINI_MODEL=
