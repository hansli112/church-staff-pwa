# 設定參考表，不會自動被 Flutter / prepare-deployment.mjs 載入。
# 本機實際值放 gitignored .env 或 .local/；CI 用 GitHub Variables/Secrets。
# church.json 設定路徑及建置指令見 docs/deployment.md。

# ── GitHub Actions：main/dev push會觸發，缺自己的設定則fail-fast ───────────
# 正式使用前請依 workflow 的 Secret／Variable 契約設定；不要複製上游的 project。
# GitHub Secret（workflow 由 secrets.CLOUDFLARE_ACCOUNT_ID 讀取）
CLOUDFLARE_ACCOUNT_ID=
# GitHub Variable
CLOUDFLARE_PAGES_PROJECT=
# Secret；限定所需帳號與 Pages 部署權限，不可進 Flutter bundle
CLOUDFLARE_API_TOKEN=
# JSON 全文（來自自己的 .local/church.json）；沒有任何 server secrets
CHURCH_CONFIG_JSON=
# 選填 GitHub Variable：runner中的PNG資產目錄，預設web。
# 客製素材可自行備妥，或用下方固定Git版本還原；不讀你電腦的.local。
CHURCH_ASSETS_DIR=web
# 選填：完整40hex commit SHA；空值不啟用Git取圖。
# 僅適用素材已在自己的Git歷史且有權使用；CI只從本repo的origin取得。
# 啟用時CHURCH_ASSETS_DIR必須改為gitignored .local子目錄，例如.local/branding。
CHURCH_ASSETS_GIT_REF=

# ── Firebase Web build 設定：會公開在瀏覽器，不是 server credentials ───────
# GitHub Variables / 本機 .local/firebase-web.json；與自己的 Firebase Web app 一致
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# 選用 Google Calendar 前端讀取；calendar=true 才需要。
# API key 最終會公開：限制 HTTP referrers 及 Google Calendar API 用途。
# 日曆須能公開讀取；不支援以此 API key 讀私密日曆。
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=

# 選用 FCM 接收：這是 VAPID 公鑰，不是私鑰；pushNotifications=true 才需要。
FCM_WEB_VAPID_KEY=

# ── Cloudflare Pages 執行期：Production / Preview 分開設 ─────────────────
# 與 build 使用相同 Firebase project；勿把前端 key 當作資料授權。
# FIREBASE_PROJECT_ID=
# GOOGLE_CALENDAR_ID=
# 共用 ChurchConfig 由 staging 產生 worker/generated_config.js；不要用不同設定覆蓋。

# Secret：日曆寫入用 service account JSON，絕不可 --dart-define 或提交到 Git。
# 日曆另分享給 service account email（變更活動）。
GOOGLE_SERVICE_ACCOUNT_JSON=

# Secret：選用照片辨識的 Gemini key，只能放 Cloudflare 執行期。
# 部署者自行確認隱私／配額／付款設定；不保證免費或可用。
GEMINI_API_KEY=
# 選填：依 worker/gemini.js 支援的模型自行測試；留空使用程式預設。
GEMINI_MODEL=

# 自行架設的 LINE/n8n 相容通知接收端（選用），請勿讓 Preview 誤發正式群組。
# webhook 必須驗證 x-notify-secret。URL 若含憑證也須當作 Secret。
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# ── 選用 GitHub 靈糧 workflow，統一讀上面的 CHURCH_CONFIG_JSON ───────────
# devotional.enabled=true 且 fetchUrl 非空才抓取。
# devotional.fetchFormat: json（預設）或 dailyBibleHtml（既有固定版型adapter）。
# 日期使用同份設定的 timeZone；cron本身仍以UTC計算。
# dataUrl=App讀JSON的位置，linkUrl=點擊網站，fetchUrl=workflow抓取來源。
# 不另設獨立feed URL／時區變數，避免三端設定漂移；HTTPS驗證不可跳過。

# ── 限制功能的Docker/nginx路線 ───────────────────────────────────────────
# docker compose build同樣需要CHURCH_CONFIG_JSON build-arg。
# 靜態nginx不跑Pages Functions；calendar/photoImport/lineNotifications須關閉。

# ── 僅本機 bootstrap --apply 使用，不是 App 設定 ─────────────────────────
# 預設使用 gcloud ADC；需要時才提供短期 OAuth token，不要提交或寫入CI log。
# GOOGLE_OAUTH_ACCESS_TOKEN=
