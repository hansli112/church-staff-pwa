rules_version = '2';

// Cloud Storage rules for 馬大別忙.
//
// Client uploads: a church logo at churches/{cid}/logo.png (the app resizes
// it to 512px before upload; these rules are the real limit), a 備註's files
// and a move file at moves/{uid}/….
// Membership and admin role come from Firestore, the same documents
// firestore.rules checks, so the tenant boundary is the same.
service firebase.storage {
  match /b/{bucket}/o {
    function memberDoc(cid) {
      return /databases/(default)/documents/churches/$(cid)/members/$(request.auth.uid);
    }

    function churchDoc(cid) {
      return /databases/(default)/documents/churches/$(cid);
    }

    function isMember(cid) {
      return request.auth != null
        && firestore.exists(memberDoc(cid))
        && firestore.get(churchDoc(cid)).data.get('status', '') == 'active';
    }

    function isAdmin(cid) {
      return isMember(cid) && firestore.get(memberDoc(cid)).data.get('role', '') == 'admin';
    }

    match /churches/{cid}/logo.png {
      allow read: if isMember(cid);
      allow write: if isAdmin(cid)
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin(cid);
    }

    // Whoever arranges any roster: admins, 行政 and every lead. The
    // function that keeps a note (saveRosterNote) checks they arrange
    // that roster, and a file no note keeps goes after a day.
    function arrangesSome(cid) {
      let m = firestore.get(memberDoc(cid)).data;
      return isAdmin(cid) || (isMember(cid) && ('roster-editors' in m.get('groups', [])
        || m.get('leadTypes', []).size() > 0 || m.get('leadMinistries', []).size() > 0
        || m.get('leadSmallGroups', []).size() > 0));
    }

    // A file a browser shows as it is, or one it downloads: no page of
    // someone's making opens from the bucket (as opensInline in the app).
    function opensSafely(file) {
      return (file.contentType.matches('application/pdf|text/plain|(image|audio|video)/[A-Za-z0-9.+-]+')
          && !file.contentType.matches('image/svg.*'))
        || file.contentDisposition.matches('attachment.*');
    }

    // 備註's files (樂譜, 練唱音檔, 投影片…): the church reads them; who
    // arranges uploads any kind up to 20 MB, saying it is theirs, and may
    // take back their own before it is kept. Each goes to a new name: one
    // already up is not written over (an upload there counts as a create).
    match /churches/{cid}/rosterNotes/{rosterId}/{fileId} {
      allow read: if isMember(cid);
      allow create: if resource == null && arrangesSome(cid)
        && request.resource.size <= 20 * 1024 * 1024
        && opensSafely(request.resource)
        && request.resource.metadata.get('uploader', '') == request.auth.uid;
      allow delete: if isMember(cid) && resource.metadata.get('uploader', '') == request.auth.uid;
    }

    // 搬家檔: only its uploader reads or writes it, up to 20MB. The move
    // functions read it with the Admin SDK and delete it once used.
    match /moves/{uid}/{file} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size <= 20 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
