rules_version = '2';

// Cloud Storage rules for 馬大別忙.
//
// Client uploads: a church logo at churches/{cid}/logo.png (the app resizes
// it to 512px before upload; these rules are the real limit) and a move file
// at moves/{uid}/….
// Membership and admin role come from Firestore, the same documents
// firestore.rules checks, so the tenant boundary is the same.
service firebase.storage {
  match /b/{bucket}/o {
    function memberDoc(cid) {
      return /databases/(default)/documents/churches/$(cid)/members/$(request.auth.uid);
    }

    function churchDoc(cid) {
      return /databases/(default)/documents/churches/$(cid);
    }

    function isMember(cid) {
      return request.auth != null
        && firestore.exists(memberDoc(cid))
        && firestore.get(churchDoc(cid)).data.get('status', '') == 'active';
    }

    function isAdmin(cid) {
      return isMember(cid) && firestore.get(memberDoc(cid)).data.get('role', '') == 'admin';
    }

    match /churches/{cid}/logo.png {
      allow read: if isMember(cid);
      allow write: if isAdmin(cid)
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin(cid);
    }

    // 搬家檔: only its uploader reads or writes it, up to 20MB. The move
    // functions read it with the Admin SDK and delete it once used.
    match /moves/{uid}/{file} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size <= 20 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
