	<array>
		<string>remote-notification</string>
	</array>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose a picture for your church’s logo, or import a photo of a paper schedule</string>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo of a paper schedule to turn it into a draft</string>
